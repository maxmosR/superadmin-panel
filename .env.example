# =============================================================================
# Super Admin Panel — environment
# Copy to `.env.local` and fill in. This console talks to the SAME Supabase
# project as the tenant app it provisions businesses for.
# =============================================================================

# Supabase project the tenant app also uses (control-plane shares its DB).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service-role key — SERVER ONLY, bypasses RLS. Used to provision businesses,
# owner auth users, domains and configs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Root domain of the tenant app, used only to render tenant login URLs in the
# dashboard (e.g. "birraora.app" -> "acme.birraora.app"). No trailing scheme.
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3000

# Google Maps for the delivery zones editor (/businesses/<id>/zones).
# BROWSER key: restrict it by HTTP referrer to every console domain, with
# "Maps JavaScript API" and "Places API (New)" enabled. NEXT_PUBLIC_* values are
# inlined at build time: set them as build-time env on the host.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Map ID (Google Cloud > Map Management), needed by Advanced Markers.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
